{
	"name": "@lilsnibbi/utils",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"version": "1.7.0",
	"type": "module",
	"private": false,
	"sideEffects": false,
	"license": "MIT",
	"files": [
		"src"
	],
	"engines": {
		"bun": "^1.3.14"
	},
	"engineStrict": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/lilsnibbi/utils"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"bench": "bun benchmarks/isLink.bench.ts",
		"check": "bun run lint && bun run typecheck && bun test",
		"format": "bun x biome format --write .",
		"lint": "bun x biome check .",
		"prepublishOnly": "bun run check",
		"pub": "bun publish --access public",
		"test": "bun test",
		"test:coverage": "bun test --coverage",
		"typecheck": "bun x tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"@types/bun": "^1.3.14",
		"discord.js": "^14.27.0",
		"mitata": "^1.0.34",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"chalk": "^5.6.2"
	},
	"peerDependencies": {
		"discord.js": "^14.27.0"
	},
	"exports": {
		".": "./src/index.ts",
		"./discord": "./src/discord/index.ts",
		"./error": "./src/error/index.ts",
		"./helpers": "./src/helpers/index.ts",
		"./logger": "./src/logger/index.ts",
		"./package.json": "./package.json"
	}
}
