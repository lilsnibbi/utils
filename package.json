{
	"name": "@lilsnibbi/utils",
	"version": "2.0.0",
	"description": "Personal TypeScript utility library for the Bun runtime.",
	"license": "MIT",
	"private": false,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./*": {
			"types": "./src/*/index.ts",
			"import": "./src/*/index.ts"
		}
	},
	"files": [
		"src"
	],
	"engines": {
		"bun": "^1.3.13"
	},
	"engineStrict": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lilsnibbi/utils.git"
	},
	"scripts": {
		"check": "bun tsc --noEmit && bun biome check .",
		"pretty": "bun biome format --write .",
		"pub": "bun publish --access public",
		"test": "bun test"
	},
	"dependencies": {
		"chalk": "^5.6.2"
	},
	"peerDependencies": {
		"discord.js": "^14.26.4"
	},
	"peerDependenciesMeta": {
		"discord.js": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@types/bun": "^1.3.14",
		"typescript": "^6.0.3"
	}
}
